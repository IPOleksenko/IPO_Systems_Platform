+
+fn mtrr_fixed_index(index: i32) -> Option<isize> {
+    match index {
+        0x250 => Some(0),
+        0x258 => Some(1),
+        0x259 => Some(2),
+        0x268..=0x26F => Some((index - 0x265) as isize),
+        _ => None,
+    }
