---
import { sharedStructTables, getStructTitle, getFieldDescription } from '../data/shared-code';
import { getTranslation } from '../utils/i18n';

interface Props {
  id: string;
  lang: string;
}

const { id, lang } = Astro.props;
const table = sharedStructTables.find((t) => t.id === id);

if (!table) {
  throw new Error(`SharedStruct table not found for ID: ${id}`);
}

const title = getStructTitle(table, lang);
---

<div class="struct-table-wrapper" id={`struct-${id}`}>
  <div class="struct-header">
    <span class="struct-title">📊 {title}</span>
    <span class="struct-badge">{table.totalSize}</span>
  </div>
  <table>
    <thead>
      <tr>
        <th style="width: 12%;">{getTranslation(lang, 'tables.struct.offset')}</th>
        <th style="width: 14%;">{getTranslation(lang, 'tables.struct.size')}</th>
        <th style="width: 18%;">{getTranslation(lang, 'tables.struct.type')}</th>
        <th style="width: 22%;">{getTranslation(lang, 'tables.struct.name')}</th>
        <th>{getTranslation(lang, 'tables.struct.description')}</th>
      </tr>
    </thead>
    <tbody>
      {table.fields.map((f) => (
        <tr>
          <td><code>{f.offset}</code></td>
          <td>{f.size}</td>
          <td><code>{f.type}</code></td>
          <td><strong><code>{f.name}</code></strong></td>
          <td>{getFieldDescription(f, lang)}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .struct-table-wrapper {
    margin: 1.5rem 0;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--bg-card);
    box-shadow: var(--shadow-sm);
  }

  .struct-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 1rem;
    background-color: var(--bg-tertiary);
    border-bottom: 1px solid var(--border-color);
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .struct-title {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--text-primary);
  }

  .struct-badge {
    background-color: var(--accent-light);
    color: var(--accent-primary);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    font-family: var(--font-mono);
  }

  .struct-table-wrapper table {
    margin-bottom: 0;
    min-width: 480px;
    -webkit-overflow-scrolling: touch;
  }
</style>
