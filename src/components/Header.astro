---
import { siteConfig } from '../../site.config';
import { getTranslation } from '../utils/i18n';
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import SearchModal from './SearchModal.astro';
import SiteLogo from './SiteLogo.astro';

interface Props {
  currentLang: string;
  currentSlug?: string;
}

const { currentLang, currentSlug = '' } = Astro.props;
const homeTitle = siteConfig.siteTitle;
const base = siteConfig.base;
const cleanBase = base.endsWith('/') ? base : `${base}/`;
const homeUrl = `${cleanBase}${currentLang}/`;

let currentUrl = siteConfig.author.profileUrl;
let currentName = siteConfig.author.name;
if (currentSlug.startsWith('ipo-os')) {
  currentUrl = siteConfig.projects.ipo_os.repoUrl;
  currentName = siteConfig.projects.ipo_os.name;
} else if (currentSlug.startsWith('ipo-boot-rom')) {
  currentUrl = siteConfig.projects.ipo_boot_rom.repoUrl;
  currentName = siteConfig.projects.ipo_boot_rom.name;
} else if (currentSlug.startsWith('ipo-firmware')) {
  currentUrl = siteConfig.projects.ipo_firmware.repoUrl;
  currentName = siteConfig.projects.ipo_firmware.name;
}
---

<header class="site-header">
  <div class="header-inner">
    <div class="header-left">
      <button type="button" class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Toggle navigation">
        ☰
      </button>
      <a href={homeUrl} class="brand-link">
        <SiteLogo size={24} />
        <span class="brand-title">{homeTitle}</span>
      </a>
    </div>

    <nav class="header-nav" aria-label="Main Projects">
      <a href={`${cleanBase}${currentLang}/ipo-os/overview`} class={`nav-item ${currentSlug.startsWith('ipo-os') ? 'active' : ''}`}>
        IPO_OS
      </a>
      <a href={`${cleanBase}${currentLang}/ipo-boot-rom/overview`} class={`nav-item ${currentSlug.startsWith('ipo-boot-rom') ? 'active' : ''}`}>
        IPO_Boot_ROM
      </a>
      <a href={`${cleanBase}${currentLang}/ipo-firmware/overview`} class={`nav-item ${currentSlug.startsWith('ipo-firmware') ? 'active' : ''}`}>
        IPO_Firmware
      </a>
    </nav>

    <div class="header-right">
      <SearchModal lang={currentLang} />
      <LanguageSwitcher currentLang={currentLang} currentSlug={currentSlug} />
      <ThemeToggle lang={currentLang} />
      <a href={currentUrl} target="_blank" rel="noopener noreferrer" class="github-link" title={`GitHub - ${currentName}`} aria-label={`GitHub - ${currentName}`}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
        </svg>
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    height: var(--header-height);
    background-color: var(--bg-primary);
    border-bottom: 1px solid var(--border-color);
    backdrop-filter: blur(8px);
  }

  .header-inner {
    max-width: 90rem;
    height: 100%;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .mobile-menu-btn {
    display: none;
    background: transparent;
    border: none;
    font-size: 1.25rem;
    color: var(--text-primary);
    cursor: pointer;
    padding: 0.25rem;
  }

  @media (max-width: 1024px) {
    .mobile-menu-btn {
      display: block;
    }
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--text-primary);
    font-weight: 700;
    font-size: 1.15rem;
  }

  .brand-icon {
    width: 24px;
    height: 24px;
    display: inline-block;
    vertical-align: middle;
    flex-shrink: 0;
    border-radius: 5px;
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .header-nav {
      display: none;
    }
  }

  .nav-item {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
    transition: color 0.15s ease;
  }

  .nav-item:hover, .nav-item.active {
    color: var(--accent-primary);
  }

  .nav-item.active {
    font-weight: 600;
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .github-link {
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    padding: 0.35rem;
    border-radius: var(--radius-sm);
    transition: color 0.15s ease;
  }

  .github-link:hover {
    color: var(--text-primary);
  }
</style>

<script>
  document.getElementById('mobile-menu-btn')?.addEventListener('click', () => {
    document.querySelector('.sidebar')?.classList.toggle('open');
  });
</script>
