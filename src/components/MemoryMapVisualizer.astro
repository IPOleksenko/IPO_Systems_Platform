---
import { getTranslation, detectLang } from '../utils/i18n';

interface Props {
  lang?: string;
}

const lang = detectLang(Astro.props.lang, Astro.url, Astro.params);

const memoryRegions = [
  {
    id: 'ivt',
    name: 'IVT',
    label: '0x00000 — IVT (1 KiB)',
    start: '0x00000',
    end: '0x003FF',
    size: '1024 B',
    descKey: 'widgets.memory_map.regions.ivt'
  },
  {
    id: 'bda',
    name: 'BDA',
    label: '0x00400 — BDA (256 B)',
    start: '0x00400',
    end: '0x004FF',
    size: '256 B',
    descKey: 'widgets.memory_map.regions.bda'
  },
  {
    id: 'mbr',
    name: 'E820, MBR & SMP Trampoline',
    label: '0x06000 — E820 (0x6000), MBR (0x7C00), SMP (0x8000..0x81AF)',
    start: '0x06000',
    end: '0x08FFF',
    size: '12 KiB',
    descKey: 'widgets.memory_map.regions.mbr'
  },
  {
    id: 'vga',
    name: 'VGA Framebuffer & Text VRAM',
    label: '0xA0000 — VGA Graphics & Text VRAM (0xB8000)',
    start: '0xA0000',
    end: '0xBFFFF',
    size: '128 KiB',
    descKey: 'widgets.memory_map.regions.vga'
  },
  {
    id: 'shadow',
    name: 'Shadow RAM, Firmware & Bootblock',
    label: '0xC0000 — VBIOS, Firmware (0xF000:000C) & Bootblock (0xFE000)',
    start: '0xC0000',
    end: '0xFFFFF',
    size: '256 KiB',
    descKey: 'widgets.memory_map.regions.shadow'
  },
  {
    id: 'kernel',
    name: 'IPO_OS Kernel (1 MiB)',
    label: '0x00100000 — IPO_OS Kernel Core & SB16 DMA (0x600000)',
    start: '0x00100000',
    end: '0x007FFFFF',
    size: '7 MiB',
    descKey: 'widgets.memory_map.regions.kernel'
  },
  {
    id: 'userspace',
    name: 'Userspace Load Base & Process Heaps',
    label: '0x00800000 — Applications (ELF32 / .bin) & Process Heaps',
    start: '0x00800000',
    end: '0x03FFFFFF',
    size: '56 MiB',
    descKey: 'widgets.memory_map.regions.userspace'
  },
  {
    id: 'heap',
    name: 'Kernel kmalloc Heap & Overflow Arenas',
    label: '0x04000000 — Primary kmalloc Pool (64 MiB) + Overflow',
    start: '0x04000000',
    end: '0x07FFFFFF',
    size: '64 MiB+',
    descKey: 'widgets.memory_map.regions.heap'
  },
  {
    id: 'pmm',
    name: 'PMM Physical Frame Pool',
    label: '0x08000000 — PMM Frames & Low-RAM User Heaps (0x09000000)',
    start: '0x08000000',
    end: '0x0FFFFFFF',
    size: '128 MiB',
    descKey: 'widgets.memory_map.regions.pmm'
  },
  {
    id: 'user_heap',
    name: 'Isolated User Process Heaps & mmap()',
    label: '0x10000000 — USER_HEAP_START (256 MiB+ Stride) & mmap',
    start: '0x10000000',
    end: '0xBFFFFFFF',
    size: '2.75 GiB',
    descKey: 'widgets.memory_map.regions.user_heap'
  },
  {
    id: 'high_sys',
    name: 'Trampolines, IPC SHM & MMIO BARs',
    label: '0xC0000000+ — Trampolines, IPC SHM (0xD0000000+) & PCI MMIO',
    start: '0xC0000000',
    end: '0xFFFFFFFF+',
    size: '1 GiB+',
    descKey: 'widgets.memory_map.regions.high_sys'
  }
];

const initialRegion = memoryRegions[0];
---

<div class="mem-visualizer-widget">
  <div class="widget-header">
    <strong>🧮 {getTranslation(lang, 'widgets.memory_map.title')}</strong>
    <span class="widget-badge">{getTranslation(lang, 'widgets.memory_map.badge')}</span>
  </div>

  <div class="mem-layout-grid">
    <div class="mem-sidebar-list" role="tablist">
      {memoryRegions.map((region, idx) => (
        <button 
          class={`mem-btn ${idx === 0 ? 'active' : ''}`}
          data-addr-start={region.start}
          data-addr-end={region.end}
          data-size={region.size}
          data-name={region.name}
          data-desc={getTranslation(lang, region.descKey)}
        >
          {region.label}
        </button>
      ))}
    </div>

    <div class="mem-details-panel">
      <h4 id="mem-region-name">{initialRegion.start} — {initialRegion.name}</h4>
      <div class="mem-meta-row">
        <span><strong>{getTranslation(lang, 'widgets.memory_map.start')}</strong> <code id="mem-start">{initialRegion.start}</code></span>
        <span><strong>{getTranslation(lang, 'widgets.memory_map.end')}</strong> <code id="mem-end">{initialRegion.end}</code></span>
        <span><strong>{getTranslation(lang, 'widgets.memory_map.size')}</strong> <span id="mem-size">{initialRegion.size}</span></span>
      </div>
      <p id="mem-desc" class="mem-desc">
        {getTranslation(lang, initialRegion.descKey)}
      </p>
    </div>
  </div>
</div>

<style>
  .mem-visualizer-widget {
    margin: 2rem 0;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background-color: var(--bg-card);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .widget-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1.25rem;
    background-color: var(--bg-tertiary);
    border-bottom: 1px solid var(--border-color);
  }

  .widget-badge {
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    background-color: var(--accent-light);
    color: var(--accent-primary);
  }

  .mem-layout-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    padding: 1.25rem;
  }

  @media (max-width: 768px) {
    .mem-layout-grid {
      grid-template-columns: 1fr;
    }
  }

  .mem-sidebar-list {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .mem-btn {
    text-align: start;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    background-color: var(--bg-secondary);
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .mem-btn:hover {
    background-color: var(--bg-tertiary);
    border-color: var(--accent-primary);
  }

  .mem-btn.active {
    background-color: var(--accent-light);
    border-color: var(--accent-primary);
    color: var(--accent-primary);
    font-weight: 600;
  }

  .mem-details-panel {
    padding: 1rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    background-color: var(--bg-secondary);
  }

  .mem-meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 0.75rem 0;
    font-size: 0.9rem;
  }

  .mem-desc {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }
</style>

<script>
  document.querySelectorAll('.mem-visualizer-widget').forEach((widget) => {
    const buttons = widget.querySelectorAll('.mem-btn');
    const nameEl = widget.querySelector('#mem-region-name');
    const startEl = widget.querySelector('#mem-start');
    const endEl = widget.querySelector('#mem-end');
    const sizeEl = widget.querySelector('#mem-size');
    const descEl = widget.querySelector('#mem-desc');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        const name = btn.getAttribute('data-name');
        const start = btn.getAttribute('data-addr-start');
        const end = btn.getAttribute('data-addr-end');
        const size = btn.getAttribute('data-size');
        const desc = btn.getAttribute('data-desc');

        if (nameEl) nameEl.textContent = `${start} — ${name}`;
        if (startEl) startEl.textContent = start || '';
        if (endEl) endEl.textContent = end || '';
        if (sizeEl) sizeEl.textContent = size || '';
        if (descEl) descEl.textContent = desc || '';
      });
    });
  });
</script>
