---
import { getTranslation } from '../utils/i18n';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
---

<div class="psu-calculator-widget">
  <div class="widget-header">
    <strong>⚡ {getTranslation(lang, 'widgets.psu.title')}</strong>
    <span class="widget-badge">{getTranslation(lang, 'widgets.psu.badge')}</span>
  </div>

  <div class="calc-body">
    <div class="calc-form">
      <div class="calc-field">
        <label for="psu-cpu">{getTranslation(lang, 'widgets.psu.cpu_label')}</label>
        <select id="psu-cpu">
          <option value="65">{getTranslation(lang, 'widgets.psu.cpu_opt1')}</option>
          <option value="95" selected>{getTranslation(lang, 'widgets.psu.cpu_opt2')}</option>
          <option value="35">{getTranslation(lang, 'widgets.psu.cpu_opt3')}</option>
        </select>
      </div>

      <div class="calc-field">
        <label for="psu-ram">{getTranslation(lang, 'widgets.psu.ram_label')}</label>
        <select id="psu-ram">
          <option value="10">2x SDRAM / DDR2 (10W)</option>
          <option value="20" selected>4x DDR2 / DDR3 (20W)</option>
        </select>
      </div>

      <div class="calc-field">
        <label for="psu-storage">{getTranslation(lang, 'widgets.psu.storage_label')}</label>
        <select id="psu-storage">
          <option value="5">{getTranslation(lang, 'widgets.psu.storage_opt1')}</option>
          <option value="25" selected>{getTranslation(lang, 'widgets.psu.storage_opt2')}</option>
          <option value="45">{getTranslation(lang, 'widgets.psu.storage_opt3')}</option>
        </select>
      </div>

      <div class="calc-field">
        <label for="psu-pci">{getTranslation(lang, 'widgets.psu.pci_label')}</label>
        <select id="psu-pci">
          <option value="15" selected>{getTranslation(lang, 'widgets.psu.pci_opt1')}</option>
          <option value="40">{getTranslation(lang, 'widgets.psu.pci_opt2')}</option>
        </select>
      </div>
    </div>

    <div class="calc-result-box">
      <div class="res-label">{getTranslation(lang, 'widgets.psu.peak_label')}</div>
      <div class="res-watts" id="psu-base-watts">155 W</div>
      <div class="res-rec">
        {getTranslation(lang, 'widgets.psu.rec_label')}
      </div>
      <div class="res-rec-watts" id="psu-rec-watts">250 W — 300 W</div>
      <p class="res-note">
        {getTranslation(lang, 'widgets.psu.note')}
      </p>
    </div>
  </div>
</div>

<style>
  .psu-calculator-widget {
    margin: 2rem 0;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background-color: var(--bg-card);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .calc-body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    padding: 1.25rem;
  }

  @media (max-width: 768px) {
    .calc-body {
      grid-template-columns: 1fr;
    }
  }

  .calc-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .calc-field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .calc-field label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .calc-field select {
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-color);
    background-color: var(--bg-secondary);
    color: var(--text-primary);
    font-size: 1rem;
  }

  .calc-result-box {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 1.5rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    background-color: var(--bg-secondary);
  }

  @media (max-width: 480px) {
    .calc-body {
      padding: 0.85rem;
      gap: 1rem;
    }
    .calc-result-box {
      padding: 1rem 0.75rem;
    }
    .res-watts {
      font-size: 1.6rem;
    }
    .res-rec-watts {
      font-size: 1.3rem;
    }
  }

  .res-label {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .res-watts {
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0.25rem 0 1rem;
  }

  .res-rec {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .res-rec-watts {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-success);
    margin-top: 0.25rem;
  }

  .res-note {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: 1rem;
    line-height: 1.4;
  }
</style>

<script>
  function updatePsuCalc() {
    const cpu = parseInt((document.getElementById('psu-cpu') as HTMLSelectElement)?.value || '95', 10);
    const ram = parseInt((document.getElementById('psu-ram') as HTMLSelectElement)?.value || '20', 10);
    const storage = parseInt((document.getElementById('psu-storage') as HTMLSelectElement)?.value || '25', 10);
    const pci = parseInt((document.getElementById('psu-pci') as HTMLSelectElement)?.value || '15', 10);

    const base = cpu + ram + storage + pci;
    const recMin = Math.ceil((base * 1.3) / 50) * 50;
    const recMax = recMin + 50;

    const baseEl = document.getElementById('psu-base-watts');
    const recEl = document.getElementById('psu-rec-watts');

    if (baseEl) baseEl.textContent = `${base} W`;
    if (recEl) recEl.textContent = `${recMin} W — ${recMax} W`;
  }

  document.querySelectorAll('#psu-cpu, #psu-ram, #psu-storage, #psu-pci').forEach((el) => {
    el.addEventListener('change', updatePsuCalc);
  });
</script>
