---
import { siteConfig } from '../../site.config';
import { getTranslation } from '../utils/i18n';
import { getArtifactFormat, getArtifactTranslationKey, getRealArtifacts, groupArtifacts } from '../utils/artifacts';
import ArchiveDownloadOptions from './ArchiveDownloadOptions.astro';

interface Props {
  lang: string;
}

const { lang } = Astro.props;

const base = siteConfig.base;
const cleanBase = base.endsWith('/') ? base : `${base}/`;
const downloadsBase = `${cleanBase}downloads/`;

const { artifacts } = getRealArtifacts();
const artifactGroups = groupArtifacts(artifacts);
const featuredGroup = artifactGroups.find((group) => group.artifacts.some((artifact) => artifact.featured)) ?? artifactGroups[0];
const featuredArtifact = featuredGroup?.artifacts.find((artifact) => artifact.featured) ?? featuredGroup?.artifacts[0];
const otherArtifactGroups = artifactGroups.filter((group) => group.id !== featuredGroup?.id);
---

<div class="downloads-wrapper">
  <button 
    type="button" 
    class="downloads-trigger" 
    id="open-downloads-btn" 
    aria-label={getTranslation(lang, 'nav.downloads')}
    title={getTranslation(lang, 'downloads.trigger_title')}
  >
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
      <polyline points="7 10 12 15 17 10"></polyline>
      <line x1="12" y1="15" x2="12" y2="3"></line>
    </svg>
    <span class="downloads-btn-text">{getTranslation(lang, 'nav.downloads')}</span>
  </button>

  <dialog class="downloads-dialog" id="downloads-dialog">
    <div class="dialog-content">
      <div class="dialog-header">
        <div class="dialog-title-group">
          <span class="dialog-icon">📦</span>
          <div>
            <h2 class="dialog-title">
              {getTranslation(lang, 'downloads.dialog_title')}
            </h2>
            <p class="dialog-subtitle">
              {getTranslation(lang, 'downloads.dialog_subtitle')}
            </p>
          </div>
        </div>
        <button type="button" class="dialog-close" id="close-downloads-btn" aria-label={getTranslation(lang, 'interface.close_dialog')}>✕</button>
      </div>

      <div class="dialog-body">
        <!-- Featured Bundle -->
        {featuredArtifact && (
          <div class="featured-card">
            <div class="featured-badge">
              {getTranslation(lang, 'downloads.featured_badge')}
            </div>
            <div class="featured-main">
              <div class="featured-info">
                <h3 class="featured-title">
                  {getTranslation(lang, 'downloads.featured_title')}
                </h3>
                <p class="featured-desc">
                  {getTranslation(lang, 'downloads.featured_desc')}
                </p>
              </div>
              <div class="featured-action">
                {featuredGroup?.artifacts.some((artifact) => artifact.archive_group) && (
                  <ArchiveDownloadOptions
                    artifacts={featuredGroup.artifacts}
                    lang={lang}
                    downloadsBase={downloadsBase}
                    actionText={getTranslation(lang, 'downloads.download_bundle')}
                  />
                )}
              </div>
            </div>
          </div>
        )}

        <!-- Individual Components Grid -->
        <h4 class="section-title">
          {getTranslation(lang, 'downloads.components_title')}
        </h4>

        <div class="artifacts-grid">
          {otherArtifactGroups.map((group) => {
            const art = group.artifacts[0];
            const formats = [...new Set(group.artifacts.map(getArtifactFormat))];
            const artifactKey = getArtifactTranslationKey(art.id);
            const artifactName = art.category === 'bootrom'
              ? 'IPO_Boot_ROM'
              : artifactKey
                ? getTranslation(lang, `${artifactKey}.name`)
                : art.name;
            const artifactDescription = art.category === 'bootrom'
              ? getTranslation(lang, 'downloads.bootrom_binary_description')
              : artifactKey
                ? getTranslation(lang, `${artifactKey}.description`)
                : art.description;
            return (
            <div class="artifact-card">
              <div class="card-top">
                <div class="card-icon">
                  {art.category === 'os' ? '🖥️' : (art.category === 'bootrom' ? '⚡' : (art.category === 'software' ? '📦' : '💾'))}
                </div>
                <div class="card-header-info">
                  <h5 class="card-name">{artifactName}</h5>
                  <span class="card-size">{formats.join(' · ') || art.size_formatted}</span>
                </div>
              </div>
              <p class="card-desc">
                {artifactDescription}
              </p>
              <div class="card-bottom">
                {art.archive_group || group.artifacts.length > 1 ? (
                  <ArchiveDownloadOptions
                    artifacts={group.artifacts}
                    lang={lang}
                    downloadsBase={downloadsBase}
                    actionText={getTranslation(lang, 'downloads.download_btn')}
                  />
                ) : (
                  <a href={`${downloadsBase}${art.file}`} download={art.file} class="btn-download secondary">
                    {getTranslation(lang, 'downloads.download_btn')}
                  </a>
                )}
              </div>
            </div>
            );
          })}
        </div>

      </div>
    </div>
  </dialog>
</div>

<style>
  .downloads-wrapper {
    display: inline-flex;
    align-items: center;
  }

  .downloads-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.75rem;
    background-color: var(--accent-light);
    color: var(--accent-primary);
    border: 1px solid var(--accent-border);
    border-radius: var(--radius-md);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .downloads-trigger:hover {
    background-color: var(--accent-primary);
    color: #ffffff;
    border-color: var(--accent-primary);
  }

  @media (max-width: 768px) {
    .downloads-btn-text {
      display: none;
    }
    .downloads-trigger {
      padding: 0.35rem 0.5rem;
    }
  }

  @media (max-width: 420px) {
    .downloads-trigger {
      padding: 0.3rem 0.4rem;
    }
  }

  .downloads-dialog {
    margin: auto;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background-color: var(--bg-card);
    color: var(--text-primary);
    width: min(92vw, 750px);
    max-height: 85vh;
    box-shadow: var(--shadow-lg);
    padding: 0;
    overflow: hidden;
  }

  @media (max-width: 480px) {
    .downloads-dialog {
      width: 95vw;
      max-height: 90vh;
    }
  }

  .downloads-dialog::backdrop {
    background-color: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
  }

  .dialog-content {
    display: flex;
    flex-direction: column;
    max-height: 85vh;
    height: 100%;
    overflow: hidden;
  }

  @media (max-width: 480px) {
    .dialog-content {
      max-height: 90vh;
    }
  }

  .dialog-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--border-color);
    background-color: var(--bg-secondary);
    flex-shrink: 0;
  }

  .dialog-title-group {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .dialog-icon {
    font-size: 1.75rem;
    line-height: 1;
  }

  .dialog-title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
  }

  .dialog-subtitle {
    margin: 0.25rem 0 0;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .dialog-close {
    background: transparent;
    border: none;
    font-size: 1.2rem;
    color: var(--text-muted);
    cursor: pointer;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .dialog-close:hover {
    color: var(--text-primary);
    background-color: var(--bg-tertiary);
  }

  .dialog-body {
    padding: 1.5rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    flex: 1;
    min-height: 0;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: var(--border-color) transparent;
  }

  .dialog-body::-webkit-scrollbar {
    width: 6px;
  }

  .dialog-body::-webkit-scrollbar-track {
    background: transparent;
  }

  .dialog-body::-webkit-scrollbar-thumb {
    background-color: var(--border-color);
    border-radius: 9999px;
  }

  .dialog-body::-webkit-scrollbar-thumb:hover {
    background-color: var(--text-muted);
  }

  .featured-card {
    border: 2px solid var(--accent-primary);
    background: linear-gradient(135deg, var(--bg-card) 0%, var(--bg-secondary) 100%);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    position: relative;
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.08);
  }

  .featured-badge {
    position: absolute;
    top: -0.65rem;
    left: 1rem;
    background-color: var(--accent-primary);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.15rem 0.6rem;
    border-radius: 9999px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .featured-main {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 0.25rem;
  }

  .featured-action {
    flex: 0 1 19rem;
    min-width: min(100%, 15rem);
  }

  @media (max-width: 640px) {
    .featured-main {
      flex-direction: column;
      align-items: stretch;
    }

    .featured-action {
      width: 100%;
      flex-basis: auto;
    }
  }

  .featured-title {
    margin: 0 0 0.4rem;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .featured-desc {
    margin: 0 0 0.75rem;
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.45;
  }

  .btn-download {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.2rem;
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: all 0.15s ease;
    white-space: nowrap;
    justify-content: center;
    font-family: inherit;
    cursor: pointer;
  }

  .btn-download.primary {
    background-color: var(--accent-primary);
    color: #ffffff;
    border: 0;
  }

  .btn-download.primary:hover {
    background-color: var(--accent-primary-hover);
    transform: translateY(-1px);
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
  }

  .btn-download.secondary {
    background-color: var(--bg-tertiary);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
    padding: 0.4rem 0.75rem;
    font-size: 0.8rem;
  }

  .btn-download.secondary:hover {
    border-color: var(--accent-primary);
    color: var(--accent-primary);
  }

  .section-title {
    margin: 0.5rem 0 0;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .artifacts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 1rem;
  }

  @media (max-width: 480px) {
    .dialog-header {
      padding: 1rem;
    }
    .dialog-body {
      padding: 1rem;
      gap: 1rem;
    }
    .featured-card {
      padding: 1rem;
    }
    .btn-download.primary {
      width: 100%;
      white-space: normal;
      text-align: center;
    }
    .card-bottom {
      flex-direction: column;
      align-items: stretch;
      gap: 0.5rem;
    }
  }

  .artifact-card {
    border: 1px solid var(--border-color);
    background-color: var(--bg-secondary);
    border-radius: var(--radius-md);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: border-color 0.15s ease;
  }

  .artifact-card:hover {
    border-color: var(--accent-primary);
  }

  .card-top {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .card-icon {
    font-size: 1.4rem;
  }

  .card-name {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .card-size {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .card-desc {
    font-size: 0.82rem;
    color: var(--text-secondary);
    margin: 0 0 0.75rem;
    line-height: 1.4;
    flex: 1;
  }

  .card-bottom {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border-color);
  }
</style>

<script>
  function setupDownloadModal() {
    const dialog = document.getElementById('downloads-dialog') as HTMLDialogElement | null;
    const openBtns = document.querySelectorAll('.open-downloads-btn, #open-downloads-btn, .open-download-modal-btn');
    const closeBtn = document.getElementById('close-downloads-btn');

    if (!dialog) return;

    openBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        dialog.showModal();
      });
    });

    closeBtn?.addEventListener('click', () => {
      dialog.close();
    });

    dialog.addEventListener('click', (e) => {
      const rect = dialog.getBoundingClientRect();
      const isInDialog = (
        rect.top <= e.clientY &&
        e.clientY <= rect.top + rect.height &&
        rect.left <= e.clientX &&
        e.clientX <= rect.left + rect.width
      );
      if (!isInDialog) {
        dialog.close();
      }
    });
  }

  setupDownloadModal();
  document.addEventListener('astro:page-load', setupDownloadModal);
</script>
