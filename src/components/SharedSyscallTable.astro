---
import { 
  sharedSyscallsList, 
  getSyscallDescription, 
  getSyscallArgs, 
  getSyscallReturn 
} from '../data/shared-code';
import { getTranslation } from '../utils/i18n';
import { siteConfig } from '../../site.config';

interface Props {
  lang?: string;
}

const { lang } = Astro.props;
const currentPath = Astro.url.pathname;
const pathSegments = currentPath.split('/').filter(Boolean);
const detectedLang = lang || pathSegments.find((s) => s in siteConfig.languages) || siteConfig.defaultLang;
---

<div class="syscalls-table-container">
  <table>
    <thead>
      <tr>
        <th style="width: 10%;">{getTranslation(detectedLang, 'tables.syscall.hex')}</th>
        <th style="width: 25%;">{getTranslation(detectedLang, 'tables.syscall.call')}</th>
        <th style="width: 30%;">{getTranslation(detectedLang, 'tables.syscall.signature')}</th>
        <th>{getTranslation(detectedLang, 'tables.syscall.description')}</th>
      </tr>
    </thead>
    <tbody>
      {sharedSyscallsList.map((sc) => (
        <tr id={`syscall-${sc.numHex}`}>
          <td><code>{sc.numHex}</code></td>
          <td><strong><code>{sc.name}</code></strong></td>
          <td><code>{sc.signature}</code></td>
          <td>
            <div style="margin-bottom: 0.35rem;">
              {getSyscallDescription(sc, detectedLang)}
            </div>
            <details style="font-size: 0.85rem; color: var(--text-secondary);">
              <summary style="cursor: pointer; font-weight: 500;">
                {getTranslation(detectedLang, 'tables.syscall.details')}
              </summary>
              <ul style="margin: 0.35rem 0 0.35rem 1rem;">
                {getSyscallArgs(sc, detectedLang).map((arg) => (
                  <li><code>{arg}</code></li>
                ))}
              </ul>
              <div>
                <strong>{getTranslation(detectedLang, 'tables.syscall.returns')}</strong> {getSyscallReturn(sc, detectedLang)}
              </div>
            </details>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .syscalls-table-container {
    margin: 1.5rem 0;
    overflow-x: auto;
  }
</style>
