---
import { siteConfig } from '../../site.config';
import { getTranslation } from '../utils/i18n';

const base = siteConfig.base;
const cleanBase = base.endsWith('/') ? base : `${base}/`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteConfig.siteTitle}</title>
    <script is:inline define:vars={{ cleanBase, languages: Object.keys(siteConfig.languages) }}>
      (function() {
        // 1. Saved user preference in localStorage
        const stored = localStorage.getItem('doc_lang');
        if (stored && languages.includes(stored)) {
          window.location.replace(cleanBase + stored + '/');
          return;
        }

        // 2. Browser languages priority list
        const navLangs = navigator.languages || [navigator.language || 'en'];
        let matched = 'en';

        for (const l of navLangs) {
          const lower = l.toLowerCase();
          // exact match
          if (languages.includes(lower)) {
            matched = lower;
            break;
          }
          // prefix match (e.g. ru-RU -> ru)
          const primary = lower.split('-')[0];
          if (languages.includes(primary)) {
            matched = primary;
            break;
          }
        }

        window.location.replace(cleanBase + matched + '/');
      })();
    </script>
  </head>
  <body>
    <noscript>
      <div style="font-family: system-ui, sans-serif; max-width: 720px; margin: 4rem auto; text-align: center; padding: 2rem;">
        <h1>{siteConfig.siteTitle}</h1>
        <p style="color: #666; margin-bottom: 2rem;">
          {Object.keys(siteConfig.languages).map((code) => getTranslation(code, 'ui.select_language')).join(' · ')}
        </p>
        <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem;">
          {Object.entries(siteConfig.languages).map(([code, meta]) => (
            <a
              href={`${cleanBase}${code}/`}
              style="padding: 0.6rem 1.1rem; border: 1px solid #ddd; border-radius: 6px; text-decoration: none; color: #111; font-weight: 500; display: inline-flex; align-items: center; gap: 0.5rem; background: #fafafa; transition: all 0.15s ease;"
            >
              <span>{meta.flag}</span>
              <span>{meta.name}</span>
            </a>
          ))}
        </div>
      </div>
    </noscript>
  </body>
</html>
