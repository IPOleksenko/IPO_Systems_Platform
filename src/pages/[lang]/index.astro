---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import LocalizedDiagram from '../../components/LocalizedDiagram.astro';
import ArchiveDownloadOptions from '../../components/ArchiveDownloadOptions.astro';
import { siteConfig } from '../../../site.config';
import { getTranslation } from '../../utils/i18n';
import { getRealArtifacts, groupArtifacts } from '../../utils/artifacts';

export function getStaticPaths() {
  return Object.keys(siteConfig.languages).map((lang) => ({
    params: { lang }
  }));
}

const { lang } = Astro.params;
const currentLang = lang || 'en';

const base = siteConfig.base;
const cleanBase = base.endsWith('/') ? base : `${base}/`;
const downloadsBase = `${cleanBase}downloads/`;
const { artifacts } = getRealArtifacts();
const osArtifact = artifacts.find((a) => a.id === 'ipo-os-raw') ?? artifacts.find((a) => a.file === 'IPO_OS.img');
const fwArtifact = artifacts.find((a) => a.id === 'ipo-firmware') ?? artifacts.find((a) => a.file === 'firmware.bin');
const archiveGroups = new Map(
  groupArtifacts(artifacts).map((group) => [group.id, group.artifacts])
);
---

<BaseLayout currentLang={currentLang}>
  <Header currentLang={currentLang} />

  <main class="landing-main">
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-badge">
        <span>{getTranslation(currentLang, 'home.hero_badge')}</span>
      </div>
      <h1 class="hero-title">{siteConfig.siteTitle}</h1>
      <p class="hero-subtitle">
        {getTranslation(currentLang, 'home.hero_subtitle')}
      </p>

      <div class="hero-actions">
        <a href={`${cleanBase}${currentLang}/ipo-os/overview`} class="btn btn-primary">
          IPO_OS
        </a>
        <a href={`${cleanBase}${currentLang}/ipo-os-software/overview`} class="btn btn-secondary">
          IPO_OS_Software
        </a>
        <a href={`${cleanBase}${currentLang}/ipo-boot-rom/overview`} class="btn btn-secondary">
          IPO_Boot_ROM
        </a>
        <a href={`${cleanBase}${currentLang}/ipo-firmware/overview`} class="btn btn-secondary">
          IPO_Firmware
        </a>
        <a href={`${cleanBase}${currentLang}/emulator`} class="btn btn-secondary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
            <line x1="8" y1="21" x2="16" y2="21"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
          </svg>
          <span>{getTranslation(currentLang, 'nav.emulator')}</span>
        </a>
        <button type="button" class="btn btn-download open-download-modal-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>{getTranslation(currentLang, 'downloads.download_builds')}</span>
        </button>
      </div>
    </section>

    <!-- WebAssembly Emulator Promo Card -->
    <section class="emulator-promo-section">
      <div class="emulator-promo-card">
        <div class="emulator-promo-badge">
          <span>⚡ {getTranslation(currentLang, 'home.emulator_promo_badge')}</span>
        </div>
        <div class="emulator-promo-content">
          <div class="emulator-promo-text">
            <h2>{getTranslation(currentLang, 'home.emulator_promo_title')}</h2>
            <p>{getTranslation(currentLang, 'home.emulator_promo_desc')}</p>
            <div class="emulator-promo-specs">
              <span class="spec-chip">IPO_Boot_ROM</span>
              <span class="spec-arrow">➔</span>
              <span class="spec-chip">IPO_Firmware</span>
              <span class="spec-arrow">➔</span>
              <span class="spec-chip">IPO_OS</span>
              <span class="spec-pill">{getTranslation(currentLang, 'home.emulator_promo_serial')}</span>
            </div>
          </div>
          <div class="emulator-promo-action">
            <a href={`${cleanBase}${currentLang}/emulator`} class="btn btn-primary btn-launch-emulator">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
              </svg>
              <span>{getTranslation(currentLang, 'home.emulator_promo_btn')}</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Global Stack Architecture Diagram -->
    <section class="stack-diagram-section">
      <div class="section-header">
        <h2>{getTranslation(currentLang, 'home.stack_title')}</h2>
        <p>{getTranslation(currentLang, 'home.stack_desc')}</p>
      </div>
      <LocalizedDiagram id="global_stack" lang={currentLang} figureNum={1} />
    </section>

    <!-- Project Cards Grid -->
    <section class="projects-grid-section">
      <div class="section-header">
        <h2>{getTranslation(currentLang, 'home.projects_title')}</h2>
        <p>{getTranslation(currentLang, 'home.projects_desc')}</p>
      </div>

      <div class="projects-cards">
        <!-- Card 1: IPO_OS -->
        <div class="project-card">
          <div class="card-header">
            <span class="card-badge card-badge--os">{getTranslation(currentLang, 'home_badges.os')}</span>
            <a href={siteConfig.projects.ipo_os.repoUrl} target="_blank" rel="noopener noreferrer" class="repo-badge" aria-label={getTranslation(currentLang, 'interface.open_github')}>{getTranslation(currentLang, 'nav.github')} ↗</a>
          </div>
          <h3 class="card-title">IPO_OS</h3>
          <p class="card-desc">
            {getTranslation(currentLang, 'home.os_desc')}
          </p>
          <div class="card-footer">
            <a href={`${cleanBase}${currentLang}/ipo-os/overview`} class="card-link">
              {getTranslation(currentLang, 'home.os_docs_link')}
            </a>
            <div class="archive-options">
              <div class="archive-options-fields">
                <label class="archive-options-field">
                  <span>{getTranslation(currentLang, 'downloads.choose_archive')}</span>
                  <select class="archive-options-select-static" disabled aria-label={getTranslation(currentLang, 'downloads.choose_archive')}>
                    <option selected>{getTranslation(currentLang, 'home.raw_img_512k')}</option>
                  </select>
                </label>
              </div>
              <div class="archive-options-action">
                {osArtifact && (
                  <div class="archive-options-meta" title={`SHA256: ${osArtifact.sha256}`}>
                    <span class="meta-size">💾 {osArtifact.size_formatted}</span>
                    <span class="meta-hash" tabindex="0" title={`SHA256: ${osArtifact.sha256}`}>
                      <span class="meta-hash-short">SHA256: {osArtifact.sha256.slice(0, 12)}...</span>
                      <span class="meta-hash-full">{osArtifact.sha256}</span>
                    </span>
                  </div>
                )}
                <a href={`${cleanBase}downloads/IPO_OS.img`} download="IPO_OS.img" class="archive-options-download btn-download-primary" title={getTranslation(currentLang, 'interface.download_image')}>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                  </svg>
                  <span>{getTranslation(currentLang, 'downloads.download_btn')}</span>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Card 2: IPO_Boot_ROM -->
        <div class="project-card">
          <div class="card-header">
            <span class="card-badge card-badge--bootrom">{getTranslation(currentLang, 'home_badges.boot_rom')}</span>
            <a href={siteConfig.projects.ipo_boot_rom.repoUrl} target="_blank" rel="noopener noreferrer" class="repo-badge" aria-label={getTranslation(currentLang, 'interface.open_github')}>{getTranslation(currentLang, 'nav.github')} ↗</a>
          </div>
          <h3 class="card-title">IPO_Boot_ROM</h3>
          <p class="card-desc">
            {getTranslation(currentLang, 'home.boot_rom_desc')}
          </p>
          <div class="card-footer">
            <a href={`${cleanBase}${currentLang}/ipo-boot-rom/overview`} class="card-link">
              {getTranslation(currentLang, 'home.boot_rom_docs_link')}
            </a>
            <ArchiveDownloadOptions
              artifacts={archiveGroups.get('ipo-boot-rom') ?? []}
              lang={currentLang}
              downloadsBase={downloadsBase}
              actionText={getTranslation(currentLang, 'downloads.download_btn')}
            />
          </div>
        </div>

        <!-- Card 3: IPO_Firmware -->
        <div class="project-card">
          <div class="card-header">
            <span class="card-badge card-badge--firmware">{getTranslation(currentLang, 'home_badges.firmware')}</span>
            <a href={siteConfig.projects.ipo_firmware.repoUrl} target="_blank" rel="noopener noreferrer" class="repo-badge" aria-label={getTranslation(currentLang, 'interface.open_github')}>{getTranslation(currentLang, 'nav.github')} ↗</a>
          </div>
          <h3 class="card-title">IPO_Firmware</h3>
          <p class="card-desc">
            {getTranslation(currentLang, 'home.firmware_desc')}
          </p>
          <div class="card-footer">
            <a href={`${cleanBase}${currentLang}/ipo-firmware/overview`} class="card-link">
              {getTranslation(currentLang, 'home.firmware_docs_link')}
            </a>
            <div class="archive-options">
              <div class="archive-options-fields">
                <label class="archive-options-field">
                  <span>{getTranslation(currentLang, 'downloads.choose_archive')}</span>
                  <select class="archive-options-select-static" disabled aria-label={getTranslation(currentLang, 'downloads.choose_archive')}>
                    <option selected>{getTranslation(currentLang, 'home.binary_4m_shadow')}</option>
                  </select>
                </label>
              </div>
              <div class="archive-options-action">
                {fwArtifact && (
                  <div class="archive-options-meta" title={`SHA256: ${fwArtifact.sha256}`}>
                    <span class="meta-size">💾 {fwArtifact.size_formatted}</span>
                    <span class="meta-hash" tabindex="0" title={`SHA256: ${fwArtifact.sha256}`}>
                      <span class="meta-hash-short">SHA256: {fwArtifact.sha256.slice(0, 12)}...</span>
                      <span class="meta-hash-full">{fwArtifact.sha256}</span>
                    </span>
                  </div>
                )}
                <a href={`${downloadsBase}firmware.bin`} download="firmware.bin" class="archive-options-download btn-download-primary">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                  </svg>
                  <span>{getTranslation(currentLang, 'downloads.download_btn')}</span>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Card 4: IPO_OS_Software -->
        <div class="project-card">
          <div class="card-header">
            <span class="card-badge card-badge--software">{getTranslation(currentLang, 'home_badges.software')}</span>
            <a href={siteConfig.projects.ipo_os_software.repoUrl} target="_blank" rel="noopener noreferrer" class="repo-badge" aria-label={getTranslation(currentLang, 'interface.open_github')}>{getTranslation(currentLang, 'nav.github')} ↗</a>
          </div>
          <h3 class="card-title">IPO_OS_Software</h3>
          <p class="card-desc">
            {getTranslation(currentLang, 'home.software_desc')}
          </p>
          <div class="card-footer">
            <a href={`${cleanBase}${currentLang}/ipo-os-software/overview`} class="card-link">
              {getTranslation(currentLang, 'home.software_docs_link')}
            </a>
            <ArchiveDownloadOptions
              artifacts={archiveGroups.get('ipo-applications') ?? []}
              lang={currentLang}
              downloadsBase={downloadsBase}
              actionText={getTranslation(currentLang, 'downloads.download_btn')}
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Quick Start Profiles -->
    <section class="roles-section">
      <div class="section-header">
        <h2>{getTranslation(currentLang, 'home.roles_title')}</h2>
        <p>{getTranslation(currentLang, 'home.roles_desc')}</p>
      </div>

      <div class="roles-grid">
        <div class="role-box">
          <div class="role-icon">🖥️</div>
          <h4>{getTranslation(currentLang, 'home.user_role_title')}</h4>
          <p>{getTranslation(currentLang, 'home.user_role_desc')}</p>
          <a href={`${cleanBase}${currentLang}/ipo-os/hardware/virtual-machines`}>
            {getTranslation(currentLang, 'home.user_role_link')}
          </a>
        </div>

        <div class="role-box">
          <div class="role-icon">💻</div>
          <h4>{getTranslation(currentLang, 'home.app_dev_title')}</h4>
          <p>{getTranslation(currentLang, 'home.app_dev_desc')}</p>
          <a href={`${cleanBase}${currentLang}/ipo-os-software/hello-world`}>
            {getTranslation(currentLang, 'home.app_dev_link')}
          </a>
        </div>

        <div class="role-box">
          <div class="role-icon">🛡️</div>
          <h4>{getTranslation(currentLang, 'home.kernel_dev_title')}</h4>
          <p>{getTranslation(currentLang, 'home.kernel_dev_desc')}</p>
          <a href={`${cleanBase}${currentLang}/ipo-os/kernel/boot-sequence`}>
            {getTranslation(currentLang, 'home.kernel_dev_link')}
          </a>
        </div>

        <div class="role-box">
          <div class="role-icon">🔧</div>
          <h4>{getTranslation(currentLang, 'home.pc_builder_title')}</h4>
          <p>{getTranslation(currentLang, 'home.pc_builder_desc')}</p>
          <a href={`${cleanBase}${currentLang}/ipo-os/hardware/assembly-guide`}>
            {getTranslation(currentLang, 'home.pc_builder_link')}
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .landing-main {
    max-width: 80rem;
    margin: 0 auto;
    padding: 3rem 1.5rem 6rem;
  }

  @media (max-width: 640px) {
    .landing-main {
      padding: 1.5rem 1rem 3rem;
    }
  }

  @media (max-width: 360px) {
    .landing-main {
      padding: 1rem 0.5rem 2.5rem;
    }
  }

  .hero-section {
    text-align: center;
    padding: 3rem 1rem 4rem;
  }

  @media (max-width: 640px) {
    .hero-section {
      padding: 1.5rem 0.5rem 2.5rem;
    }
  }

  .hero-badge {
    display: inline-block;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    background-color: var(--accent-light);
    color: var(--accent-primary);
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    border: 1px solid var(--accent-border);
  }

  .hero-title {
    font-size: 3rem;
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 1.25rem;
    color: var(--text-primary);
    letter-spacing: -0.02em;
    word-break: break-word;
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 2.25rem;
    }
  }

  @media (max-width: 480px) {
    .hero-title {
      font-size: 1.85rem;
    }
  }

  .hero-subtitle {
    font-size: 1.2rem;
    color: var(--text-secondary);
    max-width: 48rem;
    margin: 0 auto 2rem;
    line-height: 1.6;
  }

  @media (max-width: 480px) {
    .hero-subtitle {
      font-size: 1rem;
      margin-bottom: 1.5rem;
    }
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (max-width: 480px) {
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
    }
    .hero-actions .btn {
      width: 100%;
      text-align: center;
      justify-content: center;
    }
  }

  .btn {
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .btn-primary {
    background-color: var(--accent-primary);
    color: #ffffff;
  }

  .btn-primary:hover {
    background-color: var(--accent-primary-hover);
    text-decoration: none;
  }

  .btn-secondary {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
  }

  .btn-secondary:hover {
    background-color: var(--bg-tertiary);
    text-decoration: none;
  }

  .btn-download {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.4rem;
    border-radius: var(--radius-md);
    background: var(--accent-primary);
    color: #ffffff;
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    border: 1px solid var(--accent-primary);
    box-shadow: 0 2px 4px rgba(37, 99, 235, 0.2);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-download:hover {
    background: var(--accent-primary-hover);
    border-color: var(--accent-primary-hover);
    color: #ffffff;
    transform: translateY(-1px);
    box-shadow: 0 4px 8px rgba(37, 99, 235, 0.3);
  }

  .card-download-link {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-decoration: none;
    padding: 0.25rem 0.55rem;
    border-radius: var(--radius-sm);
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    transition: all 0.15s ease;
    font-family: inherit;
    cursor: pointer;
  }

  .card-download-link:hover {
    color: var(--accent-primary);
    border-color: var(--accent-primary);
    text-decoration: none;
  }

  .section-header {
    text-align: center;
    max-width: 45rem;
    margin: 0 auto 2.5rem;
  }

  .section-header h2 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
    border-bottom: none;
  }

  .section-header p {
    color: var(--text-secondary);
    font-size: 1rem;
  }

  .stack-diagram-section {
    margin: 4rem 0;
  }

  @media (max-width: 640px) {
    .stack-diagram-section {
      margin: 2rem 0;
    }
  }

  .projects-grid-section {
    margin: 5rem 0;
  }

  @media (max-width: 640px) {
    .projects-grid-section {
      margin: 2.5rem 0;
    }
  }

  .projects-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 1.5rem;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    padding: 1.75rem;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  @media (max-width: 480px) {
    .project-card {
      padding: 1.25rem 1rem;
    }
  }

  .project-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--accent-primary);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    min-height: 1.85rem;
    margin-bottom: 1rem;
  }

  .card-badge {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    text-transform: uppercase;
    font-family: var(--font-mono, monospace);
    display: inline-flex;
    align-items: center;
    border: 1px solid transparent;
    white-space: nowrap;
    line-height: 1.2;
    flex-shrink: 0;
  }

  .card-badge--os {
    background: rgba(37, 99, 235, 0.14);
    color: #60a5fa;
    border-color: rgba(37, 99, 235, 0.32);
  }

  .card-badge--bootrom {
    background: rgba(16, 185, 129, 0.14);
    color: #34d399;
    border-color: rgba(16, 185, 129, 0.32);
  }

  .card-badge--firmware {
    background: rgba(139, 92, 246, 0.14);
    color: #c084fc;
    border-color: rgba(139, 92, 246, 0.32);
  }

  .card-badge--software {
    background: rgba(245, 158, 11, 0.14);
    color: #fbbf24;
    border-color: rgba(245, 158, 11, 0.32);
  }

  :root:not([data-theme='dark']) .card-badge--os {
    background: #eff6ff;
    color: #1d4ed8;
    border-color: #bfdbfe;
  }

  :root:not([data-theme='dark']) .card-badge--bootrom {
    background: #ecfdf5;
    color: #047857;
    border-color: #a7f3d0;
  }

  :root:not([data-theme='dark']) .card-badge--firmware {
    background: #f5f3ff;
    color: #6d28d9;
    border-color: #ddd6fe;
  }

  :root:not([data-theme='dark']) .card-badge--software {
    background: #fffbeb;
    color: #b45309;
    border-color: #fde68a;
  }

  .archive-options-static-field {
    display: flex;
    align-items: center;
    width: 100%;
    min-width: 0;
    min-height: 2.45rem;
    padding: 0.5rem 0.65rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    background: var(--bg-secondary);
    color: var(--text-primary);
    font: inherit;
    font-size: 0.85rem;
    font-family: var(--font-mono, monospace);
    box-sizing: border-box;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .repo-badge {
    font-size: 0.8rem;
    color: var(--text-muted);
    text-decoration: none;
  }

  .repo-badge:hover {
    color: var(--text-primary);
    text-decoration: underline;
  }

  .card-title {
    font-size: 1.4rem;
    margin-top: 0;
    margin-bottom: 0.75rem;
  }

  .card-desc {
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.55;
    flex: 1;
    margin-bottom: 1.5rem;
  }

  .card-footer {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.75rem;
    margin-top: auto;
  }

  .card-link {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--accent-primary);
