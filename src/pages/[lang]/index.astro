---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import LocalizedDiagram from '../../components/LocalizedDiagram.astro';
import { siteConfig } from '../../../site.config';
import { getTranslation } from '../../utils/i18n';

export function getStaticPaths() {
  return Object.keys(siteConfig.languages).map((lang) => ({
    params: { lang }
  }));
}

const { lang } = Astro.params;
const currentLang = lang || 'en';

const base = siteConfig.base;
const cleanBase = base.endsWith('/') ? base : `${base}/`;
---

<BaseLayout currentLang={currentLang}>
  <Header currentLang={currentLang} />

  <main class="landing-main">
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-badge">
        <span>{getTranslation(currentLang, 'home.hero_badge')}</span>
      </div>
      <h1 class="hero-title">{siteConfig.siteTitle}</h1>
      <p class="hero-subtitle">
        {getTranslation(currentLang, 'home.hero_subtitle')}
      </p>

      <div class="hero-actions">
        <a href={`${cleanBase}${currentLang}/ipo-os/overview`} class="btn btn-primary">
          {getTranslation(currentLang, 'home.explore_os')}
        </a>
        <a href={`${cleanBase}${currentLang}/ipo-boot-rom/overview`} class="btn btn-secondary">
          {getTranslation(currentLang, 'home.explore_boot_rom')}
        </a>
        <a href={`${cleanBase}${currentLang}/ipo-firmware/overview`} class="btn btn-secondary">
          {getTranslation(currentLang, 'home.explore_firmware')}
        </a>
        <button type="button" class="btn btn-download open-download-modal-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>{getTranslation(currentLang, 'downloads.download_builds')}</span>
        </button>
      </div>
    </section>

    <!-- Global Stack Architecture Diagram -->
    <section class="stack-diagram-section">
      <div class="section-header">
        <h2>{getTranslation(currentLang, 'home.stack_title')}</h2>
        <p>{getTranslation(currentLang, 'home.stack_desc')}</p>
      </div>
      <LocalizedDiagram id="global_stack" lang={currentLang} figureNum={1} />
    </section>

    <!-- Project Cards Grid -->
    <section class="projects-grid-section">
      <div class="section-header">
        <h2>{getTranslation(currentLang, 'home.projects_title')}</h2>
        <p>{getTranslation(currentLang, 'home.projects_desc')}</p>
      </div>

      <div class="projects-cards">
        <!-- Card 1: IPO_OS -->
        <div class="project-card">
          <div class="card-header">
            <span class="card-badge" style="background-color: #eff6ff; color: #2563eb;">OS / Kernel</span>
            <a href={siteConfig.projects.ipo_os.repoUrl} target="_blank" rel="noopener noreferrer" class="repo-badge">GitHub ↗</a>
          </div>
          <h3 class="card-title">IPO_OS</h3>
          <p class="card-desc">
            {getTranslation(currentLang, 'home.os_desc')}
          </p>
          <div class="card-footer">
            <a href={`${cleanBase}${currentLang}/ipo-os/overview`} class="card-link">
              {getTranslation(currentLang, 'home.os_docs_link')}
            </a>
            <a href={`${cleanBase}downloads/IPO_OS.img`} download="IPO_OS.img" class="card-download-link" title="Download Image">
              ⬇️ IPO_OS.img
            </a>
          </div>
        </div>

        <!-- Card 2: IPO_Boot_ROM -->
        <div class="project-card">
          <div class="card-header">
            <span class="card-badge" style="background-color: #ecfdf5; color: #059669;">Reset Initializer</span>
            <a href={siteConfig.projects.ipo_boot_rom.repoUrl} target="_blank" rel="noopener noreferrer" class="repo-badge">GitHub ↗</a>
          </div>
          <h3 class="card-title">IPO_Boot_ROM</h3>
          <p class="card-desc">
            {getTranslation(currentLang, 'home.boot_rom_desc')}
          </p>
          <div class="card-footer">
            <a href={`${cleanBase}${currentLang}/ipo-boot-rom/overview`} class="card-link">
              {getTranslation(currentLang, 'home.boot_rom_docs_link')}
            </a>
            <a href={`${cleanBase}downloads/ipo-boot-rom.zip`} download="ipo-boot-rom.zip" class="card-download-link" title="Download ZIP">
              ⬇️ {getTranslation(currentLang, 'downloads.download_zip')}
            </a>
          </div>
        </div>

        <!-- Card 3: IPO_Firmware -->
        <div class="project-card">
          <div class="card-header">
            <span class="card-badge" style="background-color: #f5f3ff; color: #7c3aed;">BIOS Service Layer</span>
            <a href={siteConfig.projects.ipo_firmware.repoUrl} target="_blank" rel="noopener noreferrer" class="repo-badge">GitHub ↗</a>
          </div>
          <h3 class="card-title">IPO_Firmware</h3>
          <p class="card-desc">
            {getTranslation(currentLang, 'home.firmware_desc')}
          </p>
          <div class="card-footer">
            <a href={`${cleanBase}${currentLang}/ipo-firmware/overview`} class="card-link">
              {getTranslation(currentLang, 'home.firmware_docs_link')}
            </a>
            <a href={`${cleanBase}downloads/ipo-firmware.zip`} download="ipo-firmware.zip" class="card-download-link" title="Download ZIP">
              ⬇️ {getTranslation(currentLang, 'downloads.download_zip')}
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Quick Start Profiles -->
    <section class="roles-section">
      <div class="section-header">
        <h2>{getTranslation(currentLang, 'home.roles_title')}</h2>
        <p>{getTranslation(currentLang, 'home.roles_desc')}</p>
      </div>

      <div class="roles-grid">
        <div class="role-box">
          <div class="role-icon">🖥️</div>
          <h4>{getTranslation(currentLang, 'home.user_role_title')}</h4>
          <p>{getTranslation(currentLang, 'home.user_role_desc')}</p>
          <a href={`${cleanBase}${currentLang}/ipo-os/hardware/virtual-machines`}>
            {getTranslation(currentLang, 'home.user_role_link')}
          </a>
        </div>

        <div class="role-box">
          <div class="role-icon">💻</div>
          <h4>{getTranslation(currentLang, 'home.app_dev_title')}</h4>
          <p>{getTranslation(currentLang, 'home.app_dev_desc')}</p>
          <a href={`${cleanBase}${currentLang}/ipo-os/dev/hello-world`}>
            {getTranslation(currentLang, 'home.app_dev_link')}
          </a>
        </div>

        <div class="role-box">
          <div class="role-icon">🛡️</div>
          <h4>{getTranslation(currentLang, 'home.kernel_dev_title')}</h4>
          <p>{getTranslation(currentLang, 'home.kernel_dev_desc')}</p>
          <a href={`${cleanBase}${currentLang}/ipo-os/kernel/boot-sequence`}>
            {getTranslation(currentLang, 'home.kernel_dev_link')}
          </a>
        </div>

        <div class="role-box">
          <div class="role-icon">🔧</div>
          <h4>{getTranslation(currentLang, 'home.pc_builder_title')}</h4>
          <p>{getTranslation(currentLang, 'home.pc_builder_desc')}</p>
          <a href={`${cleanBase}${currentLang}/ipo-os/hardware/assembly-guide`}>
            {getTranslation(currentLang, 'home.pc_builder_link')}
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .landing-main {
    max-width: 80rem;
    margin: 0 auto;
    padding: 3rem 1.5rem 6rem;
  }

  @media (max-width: 640px) {
    .landing-main {
      padding: 1.5rem 1rem 3rem;
    }
  }

  @media (max-width: 360px) {
    .landing-main {
      padding: 1rem 0.5rem 2.5rem;
    }
  }

  .hero-section {
    text-align: center;
    padding: 3rem 1rem 4rem;
  }

  @media (max-width: 640px) {
    .hero-section {
      padding: 1.5rem 0.5rem 2.5rem;
    }
  }

  .hero-badge {
    display: inline-block;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    background-color: var(--accent-light);
    color: var(--accent-primary);
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    border: 1px solid var(--accent-border);
  }

  .hero-title {
    font-size: 3rem;
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 1.25rem;
    color: var(--text-primary);
    letter-spacing: -0.02em;
    word-break: break-word;
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 2.25rem;
    }
  }

  @media (max-width: 480px) {
    .hero-title {
      font-size: 1.85rem;
    }
  }

  .hero-subtitle {
    font-size: 1.2rem;
    color: var(--text-secondary);
    max-width: 48rem;
    margin: 0 auto 2rem;
    line-height: 1.6;
  }

  @media (max-width: 480px) {
    .hero-subtitle {
      font-size: 1rem;
      margin-bottom: 1.5rem;
    }
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (max-width: 480px) {
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
    }
    .hero-actions .btn {
      width: 100%;
      text-align: center;
      justify-content: center;
    }
  }

  .btn {
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .btn-primary {
    background-color: var(--accent-primary);
    color: #ffffff;
  }

  .btn-primary:hover {
    background-color: var(--accent-primary-hover);
    text-decoration: none;
  }

  .btn-secondary {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
  }

  .btn-secondary:hover {
    background-color: var(--bg-tertiary);
    text-decoration: none;
  }

  .btn-download {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: var(--accent-light);
    color: var(--accent-primary);
    border: 1px solid var(--accent-border);
    cursor: pointer;
  }

  .btn-download:hover {
    background-color: var(--accent-primary);
    color: #ffffff;
    border-color: var(--accent-primary);
  }

  .card-download-link {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-decoration: none;
    padding: 0.25rem 0.55rem;
    border-radius: var(--radius-sm);
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    transition: all 0.15s ease;
  }

  .card-download-link:hover {
    color: var(--accent-primary);
    border-color: var(--accent-primary);
    text-decoration: none;
  }

  .section-header {
    text-align: center;
    max-width: 45rem;
    margin: 0 auto 2.5rem;
  }

  .section-header h2 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
    border-bottom: none;
  }

  .section-header p {
    color: var(--text-secondary);
    font-size: 1rem;
  }

  .stack-diagram-section {
    margin: 4rem 0;
  }

  @media (max-width: 640px) {
    .stack-diagram-section {
      margin: 2rem 0;
    }
  }

  .projects-grid-section {
    margin: 5rem 0;
  }

  @media (max-width: 640px) {
    .projects-grid-section {
      margin: 2.5rem 0;
    }
  }

  .projects-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 1.5rem;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    padding: 1.75rem;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  @media (max-width: 480px) {
    .project-card {
      padding: 1.25rem 1rem;
    }
  }

  .project-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--accent-primary);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .card-badge {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-sm);
    text-transform: uppercase;
  }

  .repo-badge {
    font-size: 0.8rem;
    color: var(--text-muted);
    text-decoration: none;
  }

  .repo-badge:hover {
    color: var(--text-primary);
    text-decoration: underline;
  }

  .card-title {
    font-size: 1.4rem;
    margin-top: 0;
    margin-bottom: 0.75rem;
  }

  .card-desc {
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.55;
    flex: 1;
    margin-bottom: 1.5rem;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }

  @media (max-width: 480px) {
    .card-footer {
      flex-wrap: wrap;
      gap: 0.75rem;
    }
  }

  .card-link {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--accent-primary);
    text-decoration: none;
  }

  .card-link:hover {
    text-decoration: underline;
  }

  .roles-section {
    margin: 5rem 0 2rem;
  }

  @media (max-width: 640px) {
    .roles-section {
      margin: 2.5rem 0 1.5rem;
    }
  }

  .roles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 1.5rem;
  }

  .role-box {
    padding: 1.5rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
    background-color: var(--bg-secondary);
    display: flex;
    flex-direction: column;
  }

  .role-icon {
    font-size: 2rem;
    margin-bottom: 0.75rem;
  }

  .role-box h4 {
    margin-top: 0;
    margin-bottom: 0.5rem;
    font-size: 1.1rem;
  }

  .role-box p {
    font-size: 0.88rem;
    color: var(--text-secondary);
    flex: 1;
    margin-bottom: 1rem;
  }

  .role-box a {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--accent-primary);
    text-decoration: none;
  }

  .role-box a:hover {
    text-decoration: underline;
  }
</style>
