---
import { siteConfig } from '../../site.config';
import { getTranslation } from '../utils/i18n';
import '../styles/global.css';
import '../styles/print.css';

interface Props {
  title?: string;
  description?: string;
  currentLang: string;
}

const { title, description, currentLang } = Astro.props;
const siteTitle = siteConfig.siteTitle;
const pageTitle = title ? `${title} — ${siteTitle}` : siteTitle;
const pageDesc = description || getTranslation(currentLang, 'site.description');
const dir = siteConfig.languages[currentLang]?.dir || 'ltr';
---

<!DOCTYPE html>
<html lang={currentLang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="icon" type="image/svg+xml" href={`${siteConfig.base}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />

    <!-- OpenGraph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content="website" />

    <!-- Zero-FOUC Theme Restoration Script -->
    <script is:inline>
      const storedTheme = localStorage.getItem('doc_theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (storedTheme === 'dark' || (!storedTheme && prefersDark)) {
        document.documentElement.setAttribute('data-theme', 'dark');
      } else {
        document.documentElement.removeAttribute('data-theme');
      }

      // Universal click-to-copy for SHA256 hashes
      document.addEventListener('click', (e) => {
        const hashEl = e.target.closest ? e.target.closest('.meta-hash') : null;
        if (!hashEl) return;
        const fullSpan = hashEl.querySelector('.meta-hash-full');
        const hashText = fullSpan ? fullSpan.textContent.trim() : (hashEl.getAttribute('title') || '').replace(/^SHA256:\s*/i, '').trim();
        if (hashText && navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(hashText).then(() => {
            const shortSpan = hashEl.querySelector('.meta-hash-short');
            if (shortSpan) {
              const orig = shortSpan.textContent;
              shortSpan.textContent = '✓ Copied!';
              setTimeout(() => { shortSpan.textContent = orig; }, 1500);
            }
          }).catch(() => {});
        }
      });
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
